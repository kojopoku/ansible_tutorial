---


- name: My first ansible playbook
  hosts: all
  become: yes


  tasks:
  
    - name: update repository index 
      ansible.builtin.dn:
        update_cache: yes
      when: ansible_facts['os_family'] == "RedHat"
    

    - name: install apache package (httpd)
      ansible.builtin.dnf:
        name: httpd
        state: latest
       when: ansible_facts['os_family'] == "RedHat"


    - name: add php support for apache
      ansible.builtin.dnf:
        name: php
        state: latest
      when: ansible_facts['os_family'] == "RedHat"
    
